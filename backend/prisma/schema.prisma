// Prisma schema. Docs: https://pris.ly/d/prisma-schema
//
// Naming: models and fields are camelCase in TypeScript, and mapped to
// snake_case tables and columns in the database with @map / @@map.
//
// Keep this schema portable so moving from SQLite to Postgres later is just a
// provider swap: stick to String/Int/Boolean/DateTime/Float, use string ids,
// and avoid raw SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Player {
  id        String   @id @default(cuid())
  username  String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("players")
}

// Life stage is not stored: it is derived from ageMoons (see src/cats/lifeStage.ts)
// so the two can never disagree. Gender and breed are plain strings validated in
// code (src/cats/traits.ts) to keep the schema portable.
model Cat {
  id        String   @id @default(cuid())
  name      String
  breed     String
  gender    String
  ageMoons  Int      @map("age_moons")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cats")
}
