# systemd unit for the Catwalk backend. Copy to /etc/systemd/system/.
# Settings come from /opt/catwalk/backend/.env (see docs/deploy.md).

[Unit]
Description=Catwalk backend
After=network.target

[Service]
Type=simple
User=catwalk
WorkingDirectory=/opt/catwalk/backend
ExecStart=/usr/bin/node dist/index.js
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=3
# Keep the backend small so it can't starve other services on the box (like a Minecraft server)
MemoryMax=300M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/catwalk

[Install]
WantedBy=multi-user.target
