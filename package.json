{
  "name": "clangen",
  "version": "1.0.0",
  "description": "Clangen - A cat colony management game",
  "private": true,
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "build": "pnpm run -r build",
    "lint": "pnpm run -r lint",
    "frontend:dev": "pnpm --filter @clangen/frontend dev",
    "frontend:build": "pnpm --filter @clangen/frontend build",
    "backend:dev": "pnpm --filter @clangen/backend dev",
    "backend:build": "pnpm --filter @clangen/backend build",
    "shared:build": "pnpm --filter @clangen/shared build",
    "clean": "pnpm run -r clean && rm -rf node_modules",
    "install:all": "pnpm install"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}